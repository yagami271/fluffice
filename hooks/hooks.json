{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/server.mjs\" --background >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
